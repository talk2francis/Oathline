{
  "name": "oathline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22 <23"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.23"
    }
  },
  "scripts": {
    "oathline": "node packages/cli/dist/index.js",
    "check:core-deps": "node scripts/check-core-runtime-deps.mjs",
    "sanitize:observations": "node scripts/sanitize-observations.mjs",
    "generate:schemas": "node scripts/generate-schemas.mjs",
    "build": "pnpm check:core-deps && pnpm --recursive build",
    "test": "pnpm --recursive test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ts-json-schema-generator": "2.9.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  }
}
