{
  "name": "@oathline/demo-video",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "capture:v2": "node v2/capture.mjs",
    "prepare:v2": ".venv/bin/python v2/narrate.py && .venv/bin/python v2/prepare.py",
    "render:v2": "node v2/render.mjs",
    "capture": "node scripts/capture.mjs",
    "prepare": "node scripts/prepare-assets.mjs && node scripts/synth-music.mjs",
    "studio": "remotion studio src/index.ts",
    "render:silent": "remotion render src/index.ts OathlineDemo output/oathline-demo-silent.mp4 --codec h264 --crf 16 --pixel-format yuv420p --browser-executable=/root/.cache/ms-playwright/chromium_headless_shell-1187/chrome-linux/headless_shell",
    "render:frame": "remotion still src/index.ts OathlineDemo output/hero-frame.png --frame 945 --browser-executable=/root/.cache/ms-playwright/chromium_headless_shell-1187/chrome-linux/headless_shell",
    "render": "node scripts/render.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.344",
    "@remotion/google-fonts": "4.0.344",
    "playwright-core": "1.55.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.344"
  },
  "devDependencies": {
    "@types/react": "19.2.0",
    "typescript": "5.9.3"
  }
}
